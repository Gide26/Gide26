# Copy this file to .env and put your Twelve Data API key in .env.
# Never commit or share the real key.
TWELVEDATA_API_KEY=your_api_key_here

# Scanner reuses the last successful response for this many seconds.
LIVE_SCAN_CACHE_SECONDS=300

# Twelve Data accepts up to 120 symbols per request on eligible plans.
# Lower this if your account has a smaller batch allowance.
TWELVEDATA_BATCH_SIZE=60
